# ---- TIPPMIX AI környezeti változók ----
# Másold .env néven, és töltsd ki. A .env SOHA nem kerül a repóba (lásd .gitignore).
# A VITE_ előtagú értékek BEKERÜLNEK a frontend bundle-be (nyilvánosak) – titkot ide soha ne írj.

# ---- Szerver (Node/Express) ----
PORT=3001

# Adatmód: "live" (alapértelmezés – kulcs nélkül is: ESPN nyilvános API + hír-RSS) vagy "demo" (beépített DEMO ADAT, csak teszteléshez)
DATA_MODE=live

# Bővített élő meccsadat (API-Football, https://www.api-football.com/) – opcionális; NB I / NB II ehhez kötött
API_FOOTBALL_KEY=

# Teljes webes keresés (Tavily, https://tavily.com/) – opcionális; nélküle Bing News + Google News RSS
TAVILY_API_KEY=

# Alternatív keresés: Brave Search API – opcionális
BRAVE_SEARCH_API_KEY=

# Több fogadóiroda oddsa (The Odds API, https://the-odds-api.com/ – van ingyenes csomag) – opcionális
# Nélküle az ESPN által közölt (DraftKings) oddsokat használjuk.
ODDS_API_KEY=

# SQLite fájl helye (helyi futtatás; felhőben írható lemez vagy külső DB kell)
DATABASE_PATH=./data/tippmix-ai.db

# A backend API címe a frontend számára.
# ÜRESEN HAGYVA: relatív /api hívások (helyi fejlesztés Vite proxyval, vagy ha a frontend és az API egy hoszton van).
# KÜLÖN HOSZT esetén (pl. frontend Cloudflare Pages + backend Render): VITE_API_URL=https://az-api-domained
VITE_API_URL=

# ---- Supabase ----
# Frontend (nyilvános értékek): Supabase → Settings → API → Project URL és publishable/anon kulcs.
# A Project URL a csupasz domain, útvonal NÉLKÜL (nem /rest/v1/).
VITE_SUPABASE_URL=https://PELDA-PROJEKT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# Szerveroldali (TITOK): Settings → API → service_role. Ezzel írja a szerver a profiles előfizetési mezőit.
SUPABASE_URL=https://PELDA-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (TITKOK – csak a szerver olvassa) ----
# Stripe Dashboard → Developers → API keys (teszt mód: sk_test_…)
STRIPE_SECRET_KEY=
# Stripe CLI `stripe listen` kimenete (whsec_…) vagy Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=
# A PRO termék havi árának Price ID-ja (price_…)
STRIPE_PRICE_ID_PRO=
# A Checkout visszairányítási címe: helyben http://localhost:5173, élesben a valódi domain (pl. https://tippmix-ai.pages.dev)
APP_URL=http://localhost:5173

# CORS: mely frontend-eredetek hívhatják az API-t (vesszővel elválasztva). Csak akkor kell,
# ha a frontend KÜLÖN hoszton van (pl. Cloudflare Pages + Render backend). Üresen: csak azonos eredet.
# Példa: ALLOWED_ORIGINS=https://tippmix-ai.pages.dev,https://tippmix.hu
ALLOWED_ORIGINS=

# Adminisztrátor fiókok (vesszővel elválasztva): csak ők módosíthatják a globális modellparamétert és a kézi oddsot
ADMIN_EMAILS=

# Csak MIGRÁCIÓ futtatásához (nem kell az alkalmazásnak): Settings → Database → Connection string → URI (Session pooler).
# FONTOS: idézőjelben add meg, ha a jelszó # vagy más speciális karaktert tartalmaz!
# SUPABASE_DB_URL="postgresql://postgres.PROJEKT:JELSZO@aws-0-REGIO.pooler.supabase.com:5432/postgres"
